{
  "domain": "vector",
  "name": "Digital Dream Labs Vector (Anki Vector)",
  "codeowners": [
    "@MTrab"
  ],
  "config_flow": true,
  "dhcp": [
    {
      "hostname": "vector-*"
    }
  ],
