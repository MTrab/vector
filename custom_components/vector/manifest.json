    "pyddlvector@git+https://github.com/MTrab/pyddlvector.git@fix/sdk-initialization-handshake"
  ],
  "version": "0.1.0",
  "zeroconf": [
    {
      "type": "_tcp.local.",
      "name": "vector-*"
    }
  ]
}
